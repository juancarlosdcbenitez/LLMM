<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE factura [
    <!ELEMENT factura (datos-emisor, datos-cliente, detalle-factura)>
        <!ATTLIST factura numero CDATA #REQUIRED>
        <!ATTLIST factura fecha CDATA #REQUIRED>

    <!ELEMENT datos-emisor (nombre, cif, registro)>
    <!ELEMENT datos-cliente (nombre, cif, telefono)>

    <!ELEMENT nombre (#PCDATA)>
    <!ELEMENT cif (#PCDATA)>
    <!ELEMENT registro (#PCDATA)>
    <!ELEMENT telefono (#PCDATA)>

    <!ELEMENT detalle-factura (linea+)>
        <!ATTLIST detalle-factura importe CDATA #REQUIRED>

    <!ELEMENT linea (tipo, descripcion, cantidad, oferta?, pvp)>
        <!ATTLIST linea codigo CDATA #REQUIRED>

    <!ELEMENT tipo (#PCDATA)>
    <!ELEMENT descripcion (#PCDATA)>
    <!ELEMENT cantidad (#PCDATA)>
    <!ELEMENT oferta EMPTY>
    <!ELEMENT pvp (#PCDATA)>
]>
<factura numero="27" fecha="18/12/2013">
    <datos-emisor>
        <nombre>Librería Pérez</nombre>
        <cif>46230068H</cif>
        <registro>777888999</registro>
    </datos-emisor>

    <datos-cliente>
        <nombre>Biblioteca Tazmania</nombre>
        <cif>32111222A</cif>
        <telefono>333999444</telefono>
    </datos-cliente>

    <detalle-factura importe="89">
        <linea codigo="AV7">
            <tipo>Libro</tipo>
            <descripcion>Analítica Web 2.0</descripcion>
            <cantidad>1</cantidad>
            <oferta/>
            <pvp>29€</pvp>
        </linea>

        <linea codigo="CF3">
            <tipo>DVD</tipo>
            <descripcion>Curso de HTML</descripcion>
            <cantidad>2</cantidad>
            <pvp>30€</pvp>
        </linea>
    </detalle-factura>
</factura>

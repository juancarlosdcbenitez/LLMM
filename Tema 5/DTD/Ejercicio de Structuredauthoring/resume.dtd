<!ELEMENT resume (personal-info, education*, history*, skills)>

<!ELEMENT personal-info (name, email, phone, location)>
<!ELEMENT name (#PCDATA)>
<!ELEMENT email (#PCDATA)>
<!ELEMENT phone (#PCDATA)>
<!ELEMENT location (city, state)>
<!ELEMENT city (#PCDATA)>
<!ELEMENT state (#PCDATA)>

<!ELEMENT education (school+)>
<!ELEMENT school (name, degree, year, location)>
<!ATTLIST school type (university | college | vocational | other) #REQUIRED>
<!ELEMENT degree (#PCDATA)>
<!ELEMENT year (#PCDATA)>

<!ELEMENT history (job+)>
<!ELEMENT job (title, company, start, end?, description)>
<!ELEMENT title (#PCDATA)>
<!ELEMENT company (#PCDATA)>
<!ELEMENT start (#PCDATA)>
<!ELEMENT end (#PCDATA)>
<!ELEMENT description (#PCDATA)>

<!ELEMENT skills (skill+)>
<!ELEMENT skill (#PCDATA)>
